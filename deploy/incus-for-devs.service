[Unit]
Description=Incus for devs private SSH gateway
After=network-online.target tailscaled.service incus.service
Wants=network-online.target
Requires=incus.socket

[Service]
Type=simple
User=incus-for-devs
Group=incus-for-devs
SupplementaryGroups=incus-admin
WorkingDirectory=/var/lib/incus-for-devs
Environment=HOME=/var/lib/incus-for-devs
ExecStart=/usr/local/bin/incus-for-devs server --config /etc/incus-for-devs/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/incus-for-devs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
LimitNOFILE=1024
TasksMax=128
MemoryMax=384M

[Install]
WantedBy=multi-user.target
